# Permit2 Environment Configuration

# RPC Endpoints
ETHEREUM_RPC=https://eth-rpc.gateway.pokt.network
POLYGON_RPC=https://polygon-rpc.com
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
BSC_RPC=https://bsc-dataseed1.binance.org:443

# Private Keys (for Python sender - KEEP SECRET!)
# DO NOT commit this to git
# PERMIT_EXECUTOR_KEY=0x...

# Backend Configuration
PERMIT_STORAGE_PATH=./signatures
PERMIT_API_PORT=3000
PERMIT_ENABLE_LOGGING=true

# Permit2 Contract Address (same across all chains)
PERMIT2_ADDRESS=0x000000000022D473030F116dFC393fb8C563d921

# Network Timeouts
PERMIT_RPC_TIMEOUT=30000
PERMIT_CONFIRMATION_WAIT=300000

# Gas Configuration
# Set to 0 for automatic gas price calculation
PERMIT_GAS_PRICE=0
PERMIT_GAS_MULTIPLIER=1.2

# Token Defaults
DEFAULT_TOKEN_ETHEREUM=0x1f9840a85d5af5bf1d1762f925bdaddc4201f984
DEFAULT_TOKEN_POLYGON=0x431e0f1d4d537d00fc6f37781ba52ea66025f3e5b

# Python Configuration
PYTHON_MIN_VERSION=3.8

# Debug Mode
DEBUG=false
VERBOSE_LOGGING=false
